# Backend configuration — local development
DEBUG_DOJO_HOST=127.0.0.1
DEBUG_DOJO_PORT=8000

# Local SQLite path (used only if the application supports SQLite)
DEBUG_DOJO_DB_PATH=data/debug_dojo.db

# Aiven MySQL configuration
DEBUG_DOJO_USE_MYSQL=true
DEBUG_DOJO_MYSQL_HOST=your-aiven-hostname
DEBUG_DOJO_MYSQL_PORT=your-aiven-port
DEBUG_DOJO_MYSQL_USER=your-mysql-username
DEBUG_DOJO_MYSQL_PASSWORD=replace_with_new_mysql_password
DEBUG_DOJO_MYSQL_DATABASE=your_database_name

# MySQL TLS/SSL configuration
DEBUG_DOJO_MYSQL_SSL=true
DEBUG_DOJO_MYSQL_SSL_CA=certs/aiven_ca.pem

# Prevent silent fallback to a local database
DEBUG_DOJO_ALLOW_SQLITE_FALLBACK=false

# Authentication — generate new, strong secrets
DEBUG_DOJO_JWT_SECRET=replace_with_a_new_random_secret
DEBUG_DOJO_JWT_ALGORITHM=HS256
DEBUG_DOJO_JWT_EXPIRATION_HOURS=24
DEBUG_DOJO_TEACHER_TOKEN=replace_with_a_new_random_teacher_token

# Local Ollama AI configuration
DEBUG_DOJO_OLLAMA_URL=http://localhost:11434
DEBUG_DOJO_OLLAMA_MODEL=qwen2.5-coder:latest
DEBUG_DOJO_OLLAMA_TIMEOUT_SECONDS=10.0

# Code execution limits
DEBUG_DOJO_EXEC_TIMEOUT_SECONDS=3.0
DEBUG_DOJO_MAX_OUTPUT_CHARS=10000
DEBUG_DOJO_MAX_MEMORY_MB=128
DEBUG_DOJO_MAX_CODE_SIZE_CHARS=16384

# Code execution provider
DEBUG_DOJO_USE_JUDGE0=false